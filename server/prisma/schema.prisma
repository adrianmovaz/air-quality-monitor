generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Reading {
  id              Int      @id @default(autoincrement())
  sensorId        Int
  rawValue        Float
  adcVoltage      Float
  sensorVoltage   Float
  resistance      Float
  resistanceRatio Float
  ppm             Float
  gasDetected     Boolean
  sensorTimestamp DateTime
  createdAt       DateTime @default(now())

  @@index([sensorId, sensorTimestamp])
  @@index([gasDetected, sensorTimestamp])
}
